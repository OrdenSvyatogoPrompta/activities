# HTTPS-терминатор с самоподписанным сертификатом: Caddy сам создаёт локальный CA
# (хранится в томе caddy-data) и выпускает сертификат для $DOMAIN (домен или IP).
# HSTS не включаем: с самоподписанным сертификатом он заблокирует сайт в браузере.
{
	# При заходе по IP браузер не передаёт SNI — без этого Caddy не знает,
	# какой сертификат отдать, и обрывает рукопожатие (tlsv1 alert internal error)
	default_sni {$DOMAIN}
	# Не пытаться ставить корневой сертификат в систему внутри контейнера
	skip_install_trust
}

{$DOMAIN} {
	tls internal
	header -Server
	reverse_proxy web:8080
}
